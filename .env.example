# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
# Sign up for a free account at https://resend.com

RESEND_API_KEY=re_your_api_key_here

# Admin email address to receive contact form submissions
ADMIN_EMAIL=admin@yourdomain.com

# Instructions:
# 1. Copy this file to .env.local
# 2. Sign up for a free Resend account at https://resend.com
# 3. Get your API key from https://resend.com/api-keys
# 4. Replace RESEND_API_KEY with your actual API key
# 5. Replace ADMIN_EMAIL with the email address where you want to receive contact form submissions
# 6. Never commit .env.local to version control
